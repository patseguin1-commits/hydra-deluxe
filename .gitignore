# Hydra local outputs.
/output/

# User data the app/CLIs write next to the executable.
*.db
hydra_settings.ini
hydra_ui.ini

# ImGui window layout, written wherever the app runs from.
imgui.ini

# Local utility scripts, anything else
local/*

# Cached VC++ redistributable for the installer (installer/build_installer.ps1
# downloads it; ~25 MB, never committed). Installer output lands in build-cpp/.
installer/redist/

# C++ build tree (CMake) and IDE state.
build-cpp/
.vs/
out/
CMakeUserPresets.json
compile_commands.json

# Retired Python-era build output locations.
build/
dist/

# Claude Code local state (the shared output style stays tracked).
.claude/*
!.claude/output-styles/

# generated path reports dropped at the repo root
/hydra_paths.html

# second build tree used when Hydra.exe is running and build-cpp cannot relink
build-rel/
