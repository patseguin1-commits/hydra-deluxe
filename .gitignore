# Hydra local outputs.
/output/

# User data the app/CLIs write next to the executable. The uncapped edition
# keeps its own set alongside these.
*.db
hydra_settings.ini
hydra_uncapped_settings.ini
hydra_ui.ini
hydra_uncapped_ui.ini

# ImGui window layout, written wherever the app runs from.
imgui.ini

# Local utility scripts, anything else
local/*

# Golden parity data (removed in Phase C; ignored until then).
golden/

# C++ build tree (CMake) and IDE state.
build-cpp/
.vs/
out/
CMakeUserPresets.json
compile_commands.json

# Retired Python-era build output locations.
build/
dist/

# Claude Code local state (the shared output style stays tracked).
.claude/*
!.claude/output-styles/
